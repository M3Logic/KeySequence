  </ItemGroup>

  <ItemGroup>
    <Using Include="Terminal.Gui.Input" />
    <Using Include="Terminal.Gui.KeySequence" />
    <Using Include="Terminal.Gui.ViewBase" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
